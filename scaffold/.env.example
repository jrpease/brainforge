# Copy to .env (which is gitignored) and fill in. These power the SYNC PIPELINE only.
# Consumers reading the repo never need these.

# Figma personal access token — used by the REST API for cheap change-detection
# and structured extraction (tokens, frame metadata, image export URLs).
# Create at: https://www.figma.com/developers/api#access-tokens
FIGMA_TOKEN=

# GitHub token with READ access to private source repos (for repo sync).
# Fine-grained, read-only contents scope is enough.
GITHUB_TOKEN=

# Optional: base URL of the live site, if not already in sources.json
SITE_BASE_URL=

# Monday.com personal API token — GraphQL API (https://api.monday.com/v2), sent in the
# Authorization header. Monday has no REST API; this is the cheap direct endpoint for sync.
# Create at: Monday → your avatar → Developers → My access tokens.
MONDAY_API_TOKEN=

# Google Analytics 4 (Data API) — service-account JSON key for UNATTENDED steady-state sync.
# Create a service account, download its JSON key, and add the service-account email as a Viewer
# on the GA4 property (Admin → Property Access Management). Point this at the key file:
#   GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# For a property you only have VIEWER access to (or an org that blocks SA keys/impersonation),
# authenticate as YOURSELF with your OWN OAuth Desktop client — no var needed. gcloud's DEFAULT client
# is now blocked from the sensitive analytics.readonly scope, so create an OAuth Desktop client (add
# yourself as a Test user), download its client_secret.json, then:
#   gcloud auth application-default login --client-id-file=/path/to/client_secret.json \
#     --scopes=https://www.googleapis.com/auth/analytics.readonly,https://www.googleapis.com/auth/cloud-platform
# Enable the "Google Analytics Data API" in a Google Cloud project and set it as the ADC quota project:
#   gcloud auth application-default set-quota-project <PROJECT_ID>
# NB: Google's public GA4 demo properties are API-denied (429) — prove against a real trafficked property.
GOOGLE_APPLICATION_CREDENTIALS=

# Add one line per credential as you wire new adapters (/add-adapter reminds you which).
# Example, for the Shopify extension example (pipeline/examples/shopify.md):
# SHOPIFY_ADMIN_TOKEN=
# SHOPIFY_SHOP_DOMAIN=
