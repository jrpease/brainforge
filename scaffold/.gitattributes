# Keep the repo lean: any binary asset that DOES land here goes through Git LFS,
# so clones stay fast and history doesn't bloat. Prefer LINKS to Figma/CDN exports
# over committing binaries at all (see README.md). LFS is the fallback.

*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif  filter=lfs diff=lfs merge=lfs -text
*.pdf  filter=lfs diff=lfs merge=lfs -text
*.mp4  filter=lfs diff=lfs merge=lfs -text

# Markdown/JSON stay normal text so they diff cleanly and review well.
